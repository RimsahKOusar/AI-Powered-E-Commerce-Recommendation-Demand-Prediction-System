# core-api — copy to .env for local runs outside docker
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ecommerce
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=devJwtSecret_change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

RATE_LIMIT_AUTH_PER_MIN=10
CORS_ORIGINS=http://localhost:3000

ML_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=devInternalKey
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=devMasterKey_change_me
